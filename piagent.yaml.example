apiUrl: http://localhost:3000
apiKey: dev-api-key
machineId: machine-1
pollMs: 100
retryMs: 30000
heartbeatMs: 30000
# Debounce: a contact must read closed this long to count as a vend, then
# read open this long before the vend is reported.
minClosedMs: 100
minOpenMs: 500
dbPath: piagent-cache.db
# Slots are the machine's own column numbers. See README "Pin Assignments".
pins:
  - pin: 21
    slot: 1   # Physical 40, Pi-side brown: Diet Mountain Dew
  - pin: 16
    slot: 2   # Physical 36, Pi-side blue: Diet Mountain Dew
  - pin: 19
    slot: 3   # Physical 35, Pi-side white/green: Coke Zero
  - pin: 20
    slot: 4   # Physical 38, Pi-side green: Mountain Dew
  - pin: 26
    slot: 5   # Physical 37, Pi-side white/blue: Diet Coke
