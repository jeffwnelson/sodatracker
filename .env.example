# Copy to .env next to docker-compose.yml. Used by `docker compose up`.

# Image tag to run. CI publishes :latest on every push to main.
SODATRACKER_TAG=latest

# all    = API server + GPIO agent in one container (Raspberry Pi)
# server = API server only (no GPIO hardware)
SODATRACKER_MODE=all

API_KEY=dev-api-key
JWT_SECRET=dev-jwt-secret
ADMIN_PASSWORD=dev-admin-password

# Pin-to-slot mappings live here. See piagent.yaml.example.
PIAGENT_CONFIG_FILE=./piagent.yaml

# Overrides machineId from the YAML. Leave blank to use the YAML value.
MACHINE_ID=

# --- Slack (optional, each half turns on independently) ---
# Incoming webhook URL. Set it to get low-stock and out-of-stock pushes.
SLACK_WEBHOOK_URL=
# Signing secret from the Slack app. Set it to enable /soda slash commands.
# Without it the command route is not registered at all.
SLACK_SIGNING_SECRET=
